<template>
  <view v-if="accessReady" class="uni-container app-editor">
    <text class="app-title">{{ editing ? '修改应用' : '新增应用' }}</text>
    <view v-if="loadError" class="app-load-error">
      <text class="app-error">{{ loadError }}</text>
      <button class="app-retry" size="mini" :disabled="loading" @click="loadDetail">重试</button>
    </view>
    <text v-if="loading" class="app-status">正在加载应用信息...</text>
    <uni-forms ref="formRef" class="app-form" :modelValue="formData" :rules="rules" label-width="100px" validate-trigger="bind">
      <uni-forms-item name="app_type" label="应用类型" required>
        <uni-data-select v-model="formData.app_type" :localdata="appTypeOptions" :clear="false" :disabled="submitting || !detailReady" />
      </uni-forms-item>
      <uni-forms-item name="appid" label="AppID" required>
        <uni-easyinput v-model="formData.appid" placeholder="应用的AppID" :disabled="editing || submitting || !detailReady" trim="both" />
      </uni-forms-item>
      <uni-forms-item name="name" label="应用名称" required>
        <uni-easyinput v-model="formData.name" placeholder="应用名称" :disabled="editing || submitting || !detailReady" trim="both" />
      </uni-forms-item>
      <uni-forms-item name="introduction" label="应用简介">
        <uni-easyinput v-model="formData.introduction" placeholder="应用简介" :disabled="submitting || !detailReady" trim="both" />
      </uni-forms-item>
      <uni-forms-item name="description" label="应用描述">
        <textarea v-model="formData.description" class="uni-textarea-border app-textarea" placeholder="应用描述" :maxlength="-1" :disabled="submitting || !detailReady" />
      </uni-forms-item>
      <uni-forms-item name="remark" label="应用备注">
        <textarea v-model="formData.remark" class="uni-textarea-border app-textarea" placeholder="应用备注" :maxlength="-1" :disabled="submitting || !detailReady" />
      </uni-forms-item>
      <view class="app-actions">
        <button class="app-button" type="primary" :loading="submitting" :disabled="submitting || saved || !detailReady || !canSave" @click="submit">保存</button>
        <button class="app-button" :disabled="submitting" @click="back">返回</button>
      </view>
    </uni-forms>
  </view>
</template>

<script setup lang="ts">
import { computed, getCurrentInstance, ref } from 'vue';
import { onLoad, onShow, onUnload } from '@dcloudio/uni-app';
import { useAdminAccess, reportAdminError } from '@/common/admin-crud';
import { hasPermission, identity } from '@/common/admin-navigation';
import { validator } from '@/js_sdk/validator/opendb-app-list.js';

type AppData = { appid: string; app_type: number; name: string; introduction: string; description: string; remark: string };
const { accessReady, checkAccess, getDatabase } = useAdminAccess();
const proxy = getCurrentInstance()?.proxy as any;
const formRef = ref<{ validate(): Promise<unknown> } | null>(null);
const formData = ref<AppData>({ appid: '', app_type: 0, name: '', introduction: '', description: '', remark: '' });
const rules = { appid: validator.appid, name: validator.name, app_type: validator.app_type, introduction: validator.introduction, description: validator.description };
const appTypeOptions = [{ value: 0, text: 'uni-app' }, { value: 1, text: 'uni-app x' }];
const editing = ref(false);
const detailReady = ref(false);
const loading = ref(false);
const submitting = ref(false);
const saved = ref(false);
const loadError = ref('');
const recordId = ref('');
let targetAppid = '';
let ownerUid = '';
let ownerToken = '';
let active = true;
const sameOwner = () => active && identity().uid === ownerUid && identity().tokenExpired > Date.now()
  && uni.getStorageSync('uni_id_token') === ownerToken;
const canSave = computed(() => accessReady.value && hasPermission(editing.value ? 'UPDATE_OPENDB_APP_LIST' : 'CREATE_OPENDB_APP_LIST'));

async function loadDetail() {
  if (!sameOwner()) return;
  const db = getDatabase();
  if (!db || loading.value || !editing.value) return;
  loading.value = true;
  detailReady.value = false;
  loadError.value = '';
  recordId.value = '';
  try {
    const res = await db.collection('opendb-app-list').where({ appid: targetAppid })
      .field('appid,app_type,name,introduction,description,remark').limit(1).get();
    if (!sameOwner() || !checkAccess()) return;
    if (res.errCode) throw new Error(res.errMsg || '加载应用失败');
    const data = (res.data as (AppData & { _id: string })[])[0];
    if (!data?._id) throw new Error('应用不存在或无权访问');
    recordId.value = data._id;
    formData.value = { appid: data.appid, app_type: data.app_type ?? 0, name: data.name,
      introduction: data.introduction || '', description: data.description || '', remark: data.remark || '' };
    detailReady.value = true;
  } catch (error: any) {
    if (sameOwner()) loadError.value = error?.errMsg || error?.message || '加载应用失败，请重试';
  } finally { if (sameOwner()) loading.value = false; }
}

function back() {
  uni.navigateBack({ fail: () => { if (sameOwner()) uni.redirectTo({ url: '/pages/system/app/list' }); } });
}

async function submit() {
  if (submitting.value || saved.value || !detailReady.value || !sameOwner() || !checkAccess()) return;
  if (!canSave.value) return reportAdminError(new Error('无权保存应用'));
  if (identity().uid !== ownerUid) return reportAdminError(new Error('登录账号已变化，请重新打开页面'));
  if (!formData.value.appid.trim() || !formData.value.name.trim()) return reportAdminError(new Error('请填写 AppID 和应用名称'));
  if (![0, 1].includes(formData.value.app_type)) return reportAdminError(new Error('请选择应用类型'));
  if (!formRef.value) return;
  submitting.value = true;
  let validated = false;
  try {
    await formRef.value.validate();
    const db = getDatabase();
    if (!db || !sameOwner() || !canSave.value) return;
    validated = true;
    const value = { ...formData.value, appid: formData.value.appid.trim(), name: formData.value.name.trim(), introduction: formData.value.introduction.trim() };
    if (editing.value && !recordId.value) throw new Error('缺少应用记录 ID，请重新加载');
    const result = editing.value
      ? await db.collection('opendb-app-list').doc(recordId.value).update({ app_type: value.app_type, introduction: value.introduction, description: value.description, remark: value.remark })
      : await db.collection('opendb-app-list').add(value);
    if (!sameOwner() || !checkAccess()) return;
    if (result.errCode) throw new Error(result.errMsg || '保存应用失败');
    if (editing.value && result.updated === 0) throw new Error('应用未更新，请重新加载后重试');
    saved.value = true;
    uni.showToast({ title: editing.value ? '修改成功' : '新增成功' });
    proxy?.getOpenerEventChannel?.()?.emit?.('refreshData');
    back();
  } catch (error) {
    if (sameOwner() && (validated || !Array.isArray(error))) reportAdminError(error);
  } finally { if (sameOwner()) submitting.value = false; }
}

onLoad(query => {
  // 旧版 id 参数为 AppID，始终先查出数据库记录 ID 再更新。
  targetAppid = String(query?.id || query?.appid || '');
  editing.value = query?.id != null || query?.appid != null;
  uni.setNavigationBarTitle({ title: editing.value ? '修改应用' : '新增应用' });
  if (!checkAccess()) return;
  ownerUid = identity().uid;
  ownerToken = uni.getStorageSync('uni_id_token');
  if (editing.value) {
    if (!targetAppid) { loadError.value = '缺少 AppID'; return; }
    void loadDetail();
  } else {
    if (query?.current === '1') {
      const app = uni.getAppBaseInfo();
      formData.value = { ...formData.value, appid: app.appId || '', name: app.appName || '', app_type: 1, description: 'admin 管理后台' };
    }
    detailReady.value = true;
  }
});
onShow(() => {
  if (ownerUid && !sameOwner()) {
    detailReady.value = false;
    loadError.value = '登录身份已变化，请返回并重新打开页面';
  }
});
onUnload(() => { active = false; });
</script>

<style>
.app-editor { display: flex; flex-direction: column; }
.app-title { font-size: 20px; font-weight: bold; margin-bottom: 24px; }
.app-form { width: 100%; max-width: 792px; }
.app-textarea { width: 100%; min-height: 100px; box-sizing: border-box; }
.app-load-error { display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 20px; }
.app-error { color: #c0392b; }
.app-retry { margin: 0 12px; }
.app-status { color: #666666; margin-bottom: 20px; }
.app-actions { display: flex; flex-direction: row; flex-wrap: wrap; }
.app-button { width: 100px; margin: 0 15px 15px 0; }
</style>
