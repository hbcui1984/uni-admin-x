<template>
  <view class="not-found">
    <text class="error-code">404</text>
    <text class="error-title">页面不存在或尚未开放</text>
    <text class="error-description">当前地址不可用，请返回首页选择可访问的管理功能。</text>
    <button class="home-button" @click="goHome"><uni-icons type="home" :size="18" color="#ffffff" /><text class="home-label">返回首页</text></button>
  </view>
</template>

<script setup lang="ts">
import { onShow } from '@dcloudio/uni-app'
import { useStore } from 'vuex'
import uniIcons from '@/uni_modules/uni-icons/components/uni-icons/uni-icons.vue'
import { HOME_URL } from '@/common/admin-navigation'
const store = useStore()
function goHome() { uni.reLaunch({ url: HOME_URL }) }
onShow(() => store.commit('app/SET_ROUTES', [{ name: '首页', to: { path: HOME_URL } }, { name: '页面不存在' }]))
</script>

