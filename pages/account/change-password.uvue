<template>
  <view v-if="accessReady" class="uni-container password-page">
    <text class="password-title">{{ passwordState === 'unset' ? '设置密码' : '修改密码' }}</text>
    <text v-if="passwordState === 'loading'">正在获取账号状态</text>
    <view v-else-if="passwordState === 'error'">
      <text class="password-error">{{ errorMessage }}</text>
      <button @click="loadAccountInfo">重试</button>
      <button @click="useOldPassword">使用原密码修改</button>
    </view>
    <view v-else-if="passwordState === 'unset' && !smsEnabled">
      <text class="password-error">短信服务未启用，请联系管理员完成短信服务和模板配置。</text>
    </view>
    <view v-else-if="passwordState === 'unset' && (!mobileBound || !mobile)">
      <text class="password-error">请先绑定手机号并刷新个人资料后再设置密码。</text>
    </view>
    <view v-else class="password-form">
      <uni-forms-item v-if="passwordState === 'set' || passwordState === 'fallback'" label="原密码" required label-width="100px">
        <input v-model="oldPassword" class="password-input" password :maxlength="-1" placeholder="请输入原密码" :disabled="submitting" />
      </uni-forms-item>
      <uni-forms-item label="新密码" required label-width="100px">
        <input v-model="newPassword" class="password-input" password :maxlength="-1" placeholder="请输入新密码" :disabled="submitting" />
      </uni-forms-item>
      <uni-forms-item label="确认密码" required label-width="100px">
        <input v-model="confirmation" class="password-input" password :maxlength="-1" placeholder="请再次输入新密码" :disabled="submitting" @confirm="submit" />
      </uni-forms-item>
      <template v-if="passwordState === 'unset'">
        <uni-forms-item label="绑定手机" label-width="100px"><text>{{ maskedMobile }}</text></uni-forms-item>
        <uni-captcha ref="sendCaptchaRef" scene="send-sms-code" v-model="sendCaptcha" />
        <button class="sms-button" :disabled="sending || countdown > 0 || submitting" @click="sendCode">{{ countdown > 0 ? countdown + '秒后重试' : '获取短信验证码' }}</button>
        <uni-forms-item label="短信验证码" required label-width="100px">
          <input v-model="code" class="password-input" type="number" :maxlength="6" placeholder="请输入短信验证码" :disabled="submitting" />
        </uni-forms-item>
        <uni-captcha v-if="needCaptcha" ref="setCaptchaRef" scene="set-pwd-by-sms" v-model="setCaptcha" />
      </template>
      <text v-if="errorMessage" class="password-error">{{ errorMessage }}</text>
      <button class="password-submit" type="primary" :loading="submitting" :disabled="submitting || sending" @click="submit">{{ passwordState === 'unset' ? '设置密码' : '修改密码' }}</button>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue';
import { onLoad, onShow, onUnload } from '@dcloudio/uni-app';
import { useStore } from 'vuex';
import { checkPassword, logout } from '@/uni_modules/uni-id-pages-x/common/common.uts';
import { getAccountCloudObject } from '@/uni_modules/uni-id-pages-x/common/client-cloud.uts';
import { clearAdminNavigation, identity } from '@/common/admin-navigation';
import { useAdminAccess } from '@/common/admin-crud';
import config from '@/uni_modules/uni-id-pages-x/config.uts';
import { state } from '@/uni_modules/uni-id-pages-x/store.uts';
type UpdatePasswordResponse = { errCode: number | string; errMsg?: string };
type AccountInfoResponse = { errCode: number | string; errMsg?: string; isPasswordSet?: boolean; isMobileBound?: boolean };

const store = useStore();
const { accessReady, checkAccess: checkAdminAccess } = useAdminAccess();
const oldPassword = ref('');
const newPassword = ref('');
const confirmation = ref('');
const submitting = ref(false);
const errorMessage = ref('');
const passwordState = ref('loading');
const mobileBound = ref(false);
const mobile = ref('');
const maskedMobile = computed(() => mobile.value.length === 11 ? mobile.value.slice(0, 3) + '****' + mobile.value.slice(7) : '已绑定');
const smsEnabled = config.getBoolean('smsEnabled') === true;
const code = ref('');
const sendCaptcha = ref('');
const setCaptcha = ref('');
const sendCaptchaRef = ref<UniCaptchaComponentPublicInstance | null>(null);
const setCaptchaRef = ref<UniCaptchaComponentPublicInstance | null>(null);
const needCaptcha = ref(false);
const sending = ref(false);
const countdown = ref(0);
let timer: ReturnType<typeof setInterval> | null = null;
let accountRequest = 0;
let ownerUid = '';
let ownerToken = '';
let active = true;
let completed = false;
let fallbackRequested = false;
const sameOwner = () => active && identity().uid === ownerUid && identity().tokenExpired > Date.now()
  && uni.getStorageSync('uni_id_token') === ownerToken;

function clearPasswords() {
  oldPassword.value = '';
  newPassword.value = '';
  confirmation.value = '';
  code.value = '';
  sendCaptcha.value = '';
  setCaptcha.value = '';
}

function checkAccess() {
  if (completed || !active) return false;
  if (ownerUid && !sameOwner()) {
    accessReady.value = false;
    clearPasswords();
    const user = identity();
    if (!user.uid || user.tokenExpired <= Date.now()) checkAdminAccess();
    return false;
  }
  if (!checkAdminAccess()) return false;
  ownerUid = identity().uid;
  ownerToken = uni.getStorageSync('uni_id_token');
  return true;
}

function useOldPassword() {
  if (!checkAccess()) return;
  accountRequest++;
  clearPasswords();
  errorMessage.value = '';
  passwordState.value = 'fallback';
}

async function loadAccountInfo() {
  if (!checkAccess()) return;
  const request = ++accountRequest;
  passwordState.value = 'loading';
  errorMessage.value = '';
  try {
    const result = await getAccountCloudObject('uni-id-co').getAccountInfo<AccountInfoResponse>();
    if (!sameOwner() || request !== accountRequest) return;
    if (result?.errCode !== 0 || typeof result.isPasswordSet !== 'boolean') throw new Error(result?.errMsg || '账号状态不可用');
    mobileBound.value = result.isMobileBound === true;
    mobile.value = state.userInfo.getString('_id') === ownerUid ? (state.userInfo.getString('mobile') || '') : '';
    passwordState.value = result.isPasswordSet ? 'set' : 'unset';
  } catch (error: any) {
    if (sameOwner() && request === accountRequest) { passwordState.value = 'error'; errorMessage.value = error?.errMsg || error?.message || '获取账号状态失败'; }
  }
}

async function sendCode() {
  if (sending.value || countdown.value > 0 || !smsEnabled || passwordState.value !== 'unset' || !mobileBound.value || !checkAccess()) return;
  if (!/^1\d{10}$/.test(mobile.value)) { errorMessage.value = '绑定手机号不可用，请刷新个人资料'; return; }
  if (!sendCaptcha.value) { errorMessage.value = '请输入图形验证码'; return; }
  sending.value = true;
  errorMessage.value = '';
  try {
    const result = await getAccountCloudObject('uni-id-co').sendSmsCode<UpdatePasswordResponse>({ mobile: mobile.value, scene: 'set-pwd-by-sms', captcha: sendCaptcha.value });
    if (!sameOwner()) return;
    if (result?.errCode !== 0) throw result ?? new Error('短信发送失败，请检查短信配置');
    countdown.value = 60;
    timer = setInterval(() => { countdown.value--; if (countdown.value <= 0 && timer != null) { clearInterval(timer); timer = null; } }, 1000);
    uni.showToast({ title: '验证码发送请求成功', icon: 'none' });
  } catch (error: any) {
    if (sameOwner()) {
      sendCaptcha.value = '';
      sendCaptchaRef.value?.getImageCaptcha(false);
      errorMessage.value = error?.errCode === 'uni-id-invalid-sms-template-id' || error?.code === 'uni-id-invalid-sms-template-id' ? '短信模板未配置，请联系管理员' : (error?.errMsg || error?.message || '短信发送失败，请检查短信配置');
    }
  } finally { if (sameOwner()) sending.value = false; }
}

async function submit() {
  if (submitting.value || sending.value || completed || !checkAccess() || (passwordState.value !== 'set' && passwordState.value !== 'unset' && passwordState.value !== 'fallback')) return;
  errorMessage.value = '';
  if (passwordState.value === 'unset' && (!smsEnabled || !mobileBound.value || !mobile.value)) return;
  if ((passwordState.value !== 'unset' && !oldPassword.value) || !newPassword.value || !confirmation.value) { errorMessage.value = '请填写完整的密码信息'; return; }
  if (passwordState.value === 'unset' && !/^\d{6}$/.test(code.value)) { errorMessage.value = '请输入六位短信验证码'; return; }
  if (passwordState.value === 'unset' && needCaptcha.value && !setCaptcha.value) { errorMessage.value = '请输入图形验证码'; return; }
  if (newPassword.value !== confirmation.value) { errorMessage.value = '两次输入的新密码不一致'; return; }
  const validation = checkPassword(newPassword.value);
  if (validation.getBoolean('pass') !== true) { errorMessage.value = validation.getString('errMsg') || '新密码强度不符合要求'; return; }
  submitting.value = true;
  try {
    const co = getAccountCloudObject('uni-id-co');
    const result = passwordState.value !== 'unset'
      ? await co.updatePwd<UpdatePasswordResponse>({ oldPassword: oldPassword.value, newPassword: newPassword.value })
      : await co.setPwd<UpdatePasswordResponse>({ password: newPassword.value, code: code.value, captcha: setCaptcha.value });
    if (!sameOwner()) return;
    if (result == null || result.errCode !== 0) throw result ?? new Error('密码操作失败');
    clearPasswords();
    completed = true;
    accessReady.value = false;
    clearAdminNavigation(store);
    logout();
    uni.showToast({ title: '密码已设置，请重新登录', icon: 'none' });
  } catch (error: any) {
    if (sameOwner()) {
      const errorCode = error?.errCode || error?.code;
      if (passwordState.value === 'unset') {
        if (errorCode === 'uni-id-mobile-verify-code-error') code.value = '';
        setCaptcha.value = '';
        setCaptchaRef.value?.getImageCaptcha(false);
        if (errorCode === 'uni-id-captcha-required') needCaptcha.value = true;
      }
      errorMessage.value = error?.errMsg || error?.message || '密码操作失败，请重试';
    }
  } finally { if (sameOwner()) submitting.value = false; }
}

onLoad((options) => { fallbackRequested = options?.fallback === '1'; });
onShow(() => { if (checkAccess()) { if (fallbackRequested) { fallbackRequested = false; useOldPassword(); } else loadAccountInfo(); } });
onUnload(() => { active = false; accountRequest++; if (timer != null) clearInterval(timer); clearPasswords(); });
</script>

<style>
.password-page { display: flex; flex-direction: column; }
.password-title { font-size: 20px; font-weight: bold; margin-bottom: 24px; }
.password-form { display: flex; flex-direction: column; width: 100%; max-width: 560px; }
.password-input { height: 38px; width: 100%; padding: 0 12px; box-sizing: border-box; border: 1px solid #dcdfe6; border-radius: 4px; background-color: #ffffff; font-size: 14px; }
.password-error { color: #c0392b; font-size: 14px; margin-bottom: 18px; }
.password-submit { width: 140px; margin: 0; }
.sms-button { margin: 12px 0; }
</style>
