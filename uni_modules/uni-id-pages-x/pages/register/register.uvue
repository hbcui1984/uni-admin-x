<template>
	<view class="account-page">
		<view class="account-brand">
			<image class="account-logo" src="/static/logo.png" mode="aspectFit" />
			<text class="account-brand-name">uni-admin-x</text>
		</view>
		<view v-if="!allowPublicRegister" class="form">
			<text class="account-title">{{ blockedMessage }}</text>
			<button class="uni-btn" @click="toLogin">返回登录</button>
			<button v-if="registrationCheckFailed" class="uni-btn" @click="checkAdminRegistration">重新检查</button>
		</view>
		<view v-else class="form">
			<text class="account-title">注册账号</text>
			<view class="item">
				<text class="required">*</text>
				<uni-id-pages-x-input class="my-input" title="用户名" placeholder="用户名（字母、数字、_、-）" v-model="data.username"
					ref="usernameRef" @confirm="registerBefore"></uni-id-pages-x-input>
			</view>
			<view class="item">
				<uni-id-pages-x-input class="my-input" title="昵称" placeholder="昵称（可选，不能含@或为纯数字）"
					v-model="data.nickname" :maxlength="100" ref="nicknameRef" @confirm="registerBefore"></uni-id-pages-x-input>
			</view>
			<view class="item">
				<text class="required">*</text>
				<uni-id-pages-x-input class="my-input" title="设置密码" placeholder="请设置密码" v-model="data.password"
					:password="true" ref="passwordRef" @confirm="registerBefore"></uni-id-pages-x-input>
			</view>
			<view class="item">
				<text class="required">*</text>
				<uni-id-pages-x-input class="my-input" title="重复密码" placeholder="请重新输入密码" v-model="data.password2" :password="true"
					ref="password2Ref" @confirm="registerBefore"></uni-id-pages-x-input>
			</view>
			<view class="item mt">
				<uni-captcha v-if="captchaReady" ref="captchaRef" scene="register" v-model="data.captcha" />
				<text v-else class="account-note">{{ captchaError }}</text>
			</view>

			<uni-id-pages-x-agreements class="agreements-box" ref="agreementsRef" scope="register" />

			<button class="uni-btn" @click="registerBefore" type="primary" :loading="submitting" :disabled="submitting || data.username.trim().length == 0 || data.password.length == 0 || data.password2.length == 0 || data.captcha.length != 4">{{ submitting ? '注册中' : '注册并登录' }}</button>
			<text class="account-link" @click="toLogin">返回登录</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { loginSuccess, checkPassword, getAccountRedirect } from '@/uni_modules/uni-id-pages-x/common/common.uts';
	import { getAccountCloudObject, accountErrorMessage } from '@/uni_modules/uni-id-pages-x/common/client-cloud.uts';
	import { state } from '@/uni_modules/uni-id-pages-x/store.uts';
	import { normalizeAccountRoute, accountRouteUrl, accountLoginPath } from '../../common/account-route';
	import config from '../../config.uts';
	import { adminRegisterPath, getAdminRegistrationStatus, firstAdminRegistrationOpen, registrationStatusKnown } from '@/common/admin-registration';
	const allowPublicRegister = config.getBoolean('allowPublicRegister') == true
	const blockedMessage = ref('正在检查管理员状态…')
	const registrationCheckFailed = ref(false)
	let registrationActive = true
	let registrationRequest = 0
	async function checkAdminRegistration() {
		if (allowPublicRegister) return
		const request = ++registrationRequest
		registrationCheckFailed.value = false
		try {
			const result = await getAdminRegistrationStatus()
			if (!registrationActive || request != registrationRequest) return
			if (!registrationStatusKnown(result)) throw new Error('管理员状态未知')
			if (firstAdminRegistrationOpen(result)) {
				uni.redirectTo({ url: accountRouteUrl(adminRegisterPath, getAccountRedirect()) })
			} else blockedMessage.value = result.hasAdmin === true ? '已有超级管理员，请登录' : '首任管理员注册暂被锁定，请联系维护者'
		} catch (_) {
			if (registrationActive && request == registrationRequest) {
				blockedMessage.value = '管理员状态检查失败'
				registrationCheckFailed.value = true
			}
		}
	}
	onLoad((query : OnLoadOptions) => { normalizeAccountRoute(query) })
	onShow(() => { registrationActive = true; void checkAdminRegistration() })
	onHide(() => { registrationActive = false; registrationRequest++ })

	const usernameRef = ref<UniIdPagesXInputComponentPublicInstance | null>(null)
	const nicknameRef = ref<UniIdPagesXInputComponentPublicInstance | null>(null)
	const passwordRef = ref<UniIdPagesXInputComponentPublicInstance | null>(null)
	const password2Ref = ref<UniIdPagesXInputComponentPublicInstance | null>(null)
	const captchaRef = ref<UniCaptchaComponentPublicInstance | null>(null)
	const agreementsRef = ref<UniIdPagesXAgreementsComponentPublicInstance | null>(null)
	const submitting = ref(false)
	const completed = ref(false)
	const captchaReady = ref(false)
	const captchaError = ref('验证码服务检查中')
	onMounted(() => {
		if (!allowPublicRegister) return
		try {
			getAccountCloudObject('uni-captcha-co')
			captchaReady.value = true
		} catch (error) {
			captchaError.value = accountErrorMessage(error)
		}
	})
	function toLogin() {
		if (submitting.value) return
		uni.redirectTo({ url: accountRouteUrl(accountLoginPath, getAccountRedirect()) })
	}
	const data = reactive({
		username: "",
		nickname: "",
		password: "",
		password2: "",
		captcha: ""
	})

	function showPopupCaptcha(callback : () => void) {
		agreementsRef.value!.showPopupAgreements(callback)
	}

	function registerBefore() {
		if (submitting.value || !allowPublicRegister) return
		if (!captchaReady.value) {
			uni.showToast({ title: captchaError.value, icon: 'none' })
			return
		}
		data.username = data.username.trim()
		const myForm : UTSJSONObject = {
			username: data.username,
			password: data.password,
			password2: data.password2,
			captcha: data.captcha
		}
		const inputRefs : UTSJSONObject = {
			username: usernameRef.value,
			password: passwordRef.value,
			password2: password2Ref.value,
			nickname: nicknameRef.value
		}
		const requiredFields = [
			["username", "用户名"],
			["password", "密码"],
			["password2", "确认密码"],
			["captcha", "验证码"]
		] as string[][]

		for (const item of requiredFields) {
			const key = item[0] as string
			const errMsg = (item[1] as string) + "不能为空"
			if (myForm.get(key) == "") {
				const inputRef = inputRefs.getAny(key) as UniIdPagesXInputComponentPublicInstance | null
				if (inputRef != null) inputRef.setFocus(true)
				else captchaRef.value?.setFocus(true)
				uni.showToast({
					title: errMsg,
					icon: "none",
					duration: 3000
				})
				return
			}
		}

		const usernameRegExp = new RegExp("^[a-zA-Z0-9_-]+$")
		if (!usernameRegExp.test(data.username) || /^\d+$/.test(data.username)) {
			usernameRef.value!.setFocus(true)
			return uni.showModal({
				content: "用户名只能包含字母、数字、下划线和连字符，且不能为纯数字",
				showCancel: false,
				confirmText: "知道了"
			})
		}

		if (data.nickname.length > 0) {
			if (data.nickname.indexOf('@') != -1 || /^\d+$/.test(data.nickname) || data.nickname.length > 100) {
				nicknameRef.value!.setFocus(true)
				return uni.showModal({
					content: "昵称不能包含@、不能为纯数字，且最多100个字符",
					showCancel: false,
					confirmText: "知道了"
				})
			}
		}

		const checkPasswordRes = checkPassword(data.password)
		const isPass = checkPasswordRes.getBoolean("pass") == true
		if (!isPass) {
			const errMsg = checkPasswordRes.getString("errMsg")
			return uni.showModal({
				content: errMsg,
				showCancel: false,
				confirmText: "知道了",
				complete() {
					passwordRef.value!.setFocus(true)
				}
			})
		}

		if (data.password != data.password2) {
			return uni.showModal({
				content: "两次输入的密码不一致",
				showCancel: false,
				confirmText: "知道了",
				complete() {
					password2Ref.value!.setFocus(true)
				}
			})
		}

		if (data.captcha.length != 4) {
			return uni.showModal({
				content: "请输入验证码",
				showCancel: false,
				confirmText: "知道了",
				complete() {
					captchaRef.value!.setFocus(true)
				}
			})
		}

		if (state.pendingAgreements) {
			showPopupCaptcha(() => {
				if (!state.pendingAgreements) {
					registerBefore()
				}
			})
			return
		}

		register()
	}

	async function register() {
		if (submitting.value || !allowPublicRegister) return
		submitting.value = true
		const payload : UTSJSONObject = {
			"username": data.username,
			"nickname": data.nickname,
			"password": data.password,
			"password2": data.password2,
			"captcha": data.captcha
		}
		uni.showLoading({ "title": "请求中" })

		try {
			const uniIdCo = getAccountCloudObject('uni-id-co')
			const e = await uniIdCo.registerUser(payload)
			loginSuccess(e)
			completed.value = true
		} catch (err) {
				const error = err as UniCloudError
				console.error(error)
				if (error?.code == 'uni-captcha-verify-fail' || error?.errCode == 'uni-captcha-verify-fail') {
					captchaRef.value?.getImageCaptcha(true)
				}
				uni.showToast({
					title: accountErrorMessage(err),
					icon: 'none'
				})
		} finally {
			submitting.value = completed.value
			uni.hideLoading()
		}
	}
</script>

<style lang="scss" scoped>
	@import url("/uni_modules/uni-id-pages-x/common/common.scss");
	@import url("/uni_modules/uni-id-pages-x/common/account.scss");

	.form {
		padding-left: 15px;
	}

	.item {
		margin-top: 8px;
		position: relative;
		padding-left: 15px;
		margin-left: -15px;
	}

	.mt {
		margin-top: 16px;
	}

	.required {
		position: absolute;
		color: red;
		left: 0px;
		top: 15px;
	}
</style>
